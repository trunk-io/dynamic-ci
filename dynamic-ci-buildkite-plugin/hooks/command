#!/usr/bin/env bash
# Trunk Dynamic CI — the plugin's command hook.
#
# Buildkite runs this INSTEAD of the step's command whenever the file exists, so
# every mode is dispatched from here — including the ones where the plugin does
# not own the command and has to hand the step back explicitly.
#
#   pipeline  the plugin owns the upload step: render, plan, mark, upload. The
#             skip is taken before an agent is acquired for the skipped steps.
#   filter    the customer owns the command; `lib/filter.sh` does the work in
#             their pipe. Nothing to do here but give the step back.
#   step      the plugin owns one step and decides about that step alone.
#
# Two things this deliberately does NOT do. It never reads or writes the
# customer's YAML — `buildkite-agent pipeline upload --dry-run --format json`
# makes the agent parse it, so there is no second implementation of Buildkite's
# interpolation rules and no YAML round-trip to mangle comments or anchors. And
# it never adds anything to a pipeline but `skip`, so the worst a wrong plan can
# do is stop work happening; it cannot make anything new run.
#
# Every OPERATIONAL failure runs the work anyway. A CONFIGURATION error fails
# loudly instead — see the mode dispatch at the foot of this file.

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/jq.sh
source "${PLUGIN_DIR}/lib/jq.sh"
# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/notice.sh
source "${PLUGIN_DIR}/lib/notice.sh"

MODE="${BUILDKITE_PLUGIN_DYNAMIC_CI_MODE:-pipeline}"
PIPELINE_FILE="${BUILDKITE_PLUGIN_DYNAMIC_CI_PIPELINE-}"
TOKEN_ENV="${BUILDKITE_PLUGIN_DYNAMIC_CI_TOKEN_ENV:-TRUNK_TOKEN}"

# No path by default: `pipeline upload` has its own search order, and hardcoding
# `.buildkite/pipeline.yml` would break every customer who uses another one.
pipeline_args=()
if [[ -n ${PIPELINE_FILE} ]]; then
	pipeline_args=("${PIPELINE_FILE}")
fi
# `${a[@]+"${a[@]}"}` — expanding an empty array under `set -u` is an error
# before bash 4.4, and agent images that old are still in the wild.

log() { echo "$1" >&2; }

# Run the command Buildkite would have run without this plugin installed, and
# never return.
#
# `BUILDKITE_SHELL` rather than a bare `bash -c`: it is the shell and flags the
# agent would itself have used (default `/bin/bash -e -c`). A bare `bash -c`
# silently drops the agent's `-e`, which turns a failing first line of a
# multi-line command into a passing step.
hand_back() {
	if [[ -z ${BUILDKITE_COMMAND-} ]]; then
		exit 0
	fi
	local shell="${BUILDKITE_SHELL:-/bin/bash -e -c}"
	# shellcheck disable=SC2086 # BUILDKITE_SHELL is a command plus flags; word splitting is the point
	exec ${shell} "${BUILDKITE_COMMAND}"
}

# The plugin's own config is how we detect the one misconfiguration that is
# otherwise invisible: Buildkite derives a hook's `BUILDKITE_PLUGIN_<NAME>_`
# prefix from the plugin's directory or repository name, and a subdirectory
# plugin is exactly the case where that derivation is easy to get wrong. If no
# variable with our prefix exists at all, say so and name what did arrive.
warn_if_no_plugin_config() {
	if compgen -v | grep -q '^BUILDKITE_PLUGIN_DYNAMIC_CI_'; then
		return 0
	fi
	log "--- :trunk: Dynamic CI saw no BUILDKITE_PLUGIN_DYNAMIC_CI_* configuration."
	log "    Plugin variables present: $(compgen -v | grep '^BUILDKITE_PLUGIN_' | tr '\n' ' ')"
	log "    If the prefix above is not DYNAMIC_CI, the plugin's directory name and"
	log "    this hook disagree — the plan will be requested with defaults only."
}

# The deepest fail-open: we never got a rendered pipeline, so do exactly what the
# customer's own command would have done.
upload_plain() {
	buildkite-agent pipeline upload ${pipeline_args[@]+"${pipeline_args[@]}"}
}

# Pipeline mode: the plugin owns the upload step's command.
#
# It runs the SAME algorithm filter mode runs — resolve jq, collect keys, ask for
# a plan, apply it — by running the filter itself rather than keeping a second
# copy of it. The two used to be separate implementations of one algorithm, which
# is two sets of failure paths that can drift apart.
#
# What this mode still does that filter mode cannot: it owns BOTH ends of the
# pipe, so it renders WITH interpolation and uploads with `--no-interpolation`,
# guaranteeing exactly one interpolation pass. Filter mode has to rely on the
# customer's own `pipeline upload` for that, and cannot check.
pipeline_mode() {
	local rendered

	if ! rendered="$(buildkite-agent pipeline upload \
		${pipeline_args[@]+"${pipeline_args[@]}"} --dry-run --format json)"; then
		log "--- :trunk: Dynamic CI could not render the pipeline — running every step"
		upload_plain
		return 0
	fi

	# The filter is already rendered JSON by the time it arrives, so the filter
	# takes its no-render path. And it always emits a pipeline, whatever goes
	# wrong inside it, so its output is safe to upload unconditionally.
	"${PLUGIN_DIR}/lib/filter.sh" <<<"${rendered}" |
		buildkite-agent pipeline upload --no-interpolation
}

# Step mode: one step, one verdict. The step has already been dispatched by the
# time this runs, so a skip here means the step does no work — it cannot mean the
# step never started.
#
# **It therefore reports `passed`, not `skipped`**, and that is a real cost, not
# a cosmetic one: `previous-result-on-pr` reads exactly those conclusions, so a
# step-mode skip looks like evidence the step passed on this commit. Pipeline and
# filter mode do not have this problem because the step is marked before dispatch.
step_mode() {
	local key="${BUILDKITE_STEP_KEY-}" jq_bin plan skips reason

	# Unlike pipeline mode there is no useful degraded behaviour: the key IS the
	# request. Running the step while the customer believes Dynamic CI is
	# deciding about it is the failure worth being loud about.
	if [[ -z ${key} ]]; then
		log "--- :trunk: Dynamic CI in step mode needs a key: on this step"
		log "    Trunk identifies a Buildkite step by its key:, so there is nothing"
		log "    to ask about without one. Add a key:, or remove the plugin from"
		log "    this step."
		return 1
	fi

	if ! jq_bin="$(dci_resolve_jq "${PLUGIN_DIR}/bin")"; then
		log "--- :trunk: Dynamic CI has no usable jq — running this step"
		hand_back
	fi

	# shellcheck disable=SC2016 # `$key` is a jq variable, bound by --arg, not a shell one
	if ! plan="$(TRUNK_DCI_TOKEN_ENV="${TOKEN_ENV}" TRUNK_DCI_JQ="${jq_bin}" \
		"${PLUGIN_DIR}/lib/request-plan.sh" \
		"$("${jq_bin}" -c -n --arg key "${key}" '[$key]')")"; then
		log "--- :trunk: Dynamic CI is unavailable — running this step"
		hand_back
	fi

	dci_log_notice "${jq_bin}" "${plan}"

	if ! skips="$("${jq_bin}" -c -f "${PLUGIN_DIR}/lib/plan-to-skips.jq" <<<"${plan}")"; then
		log "--- :trunk: Dynamic CI returned a plan this version cannot read — running this step"
		hand_back
	fi

	# Absent from the skip set means run, which is also what an empty plan and an
	# unrecognised key mean. Every one of them runs the step.
	# shellcheck disable=SC2016 # `$key` is a jq variable, bound by --arg, not a shell one
	reason="$("${jq_bin}" -r --arg key "${key}" '.[$key] // empty' <<<"${skips}")"
	if [[ -z ${reason} ]]; then
		hand_back
	fi

	log "--- :trunk: ${reason}"
	log "    Dynamic CI skipped this step's work. The step reports success."
	return 0
}

# A mode this version does not implement is a CONFIGURATION error, and the one
# case that does not fail open. Fail-open exists for outages — an unreachable
# API, a missing jq — where running the work is the safe answer. A typo'd or
# unsupported mode is neither: it surfaces on the customer's very first build,
# and degrading to "do nothing, say nothing" is how a plugin gets installed,
# believed, and never skips anything.
case "${MODE}" in
pipeline)
	warn_if_no_plugin_config
	pipeline_mode
	;;
filter)
	hand_back
	;;
step)
	warn_if_no_plugin_config
	step_mode
	;;
*)
	log "--- :trunk: Dynamic CI does not support mode \"${MODE}\""
	log "    Valid modes are: pipeline, filter, step."
	exit 1
	;;
esac
