# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

ACTIONS_STEP_DEBUG=true

# Action inputs are passed as INPUT_<UPPERCASE-INPUT-NAME>.
INPUT_TOKEN=your-trunk-org-api-token
INPUT_JOB-KEYS=unit-tests
# INPUT_IGNORE-SIGNALS=estimated-cost

# Override the API base address to point at a non-production endpoint.
# TRUNK_PUBLIC_API_ADDRESS=
# TRUNK_DYNAMIC_CI_TIMEOUT_MS=30000

GITHUB_REPOSITORY=my-org/my-repo
GITHUB_WORKFLOW=Pull Request
GITHUB_WORKFLOW_REF=my-org/my-repo/.github/workflows/pr.yaml@refs/heads/main
GITHUB_RUN_ID=1
GITHUB_RUN_ATTEMPT=1
GITHUB_SHA=0000000000000000000000000000000000000000
GITHUB_REF_NAME=my-branch
